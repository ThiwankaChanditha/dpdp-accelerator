# Copyright (c) 2026, WSO2 LLC. (https://www.wso2.com).
#
# Committed defaults for a local dpdp-is install (see accelerators/dpdp-is/README.md).
# Copy this file to .env (gitignored) in this directory and fill in the credential fields -
# .env overrides these values, this file is never meant to carry real secrets.

# Base URL the consent-portal WAR is served from - the same host:port real users hit.
PORTAL_BASE_URL=https://localhost:9443/consent-portal

# Base URL of the Identity Server itself (its /oauth2/jwks, /authenticationendpoint/*, etc).
# Normally the same host as PORTAL_BASE_URL for a single-node local install.
IS_BASE_URL=https://localhost:9443

# The shipped Identity Server certificate is self-signed; set to false only against an
# environment with a properly trusted certificate.
IGNORE_HTTPS_ERRORS=true

# --- Required test accounts -----------------------------------------------------------------
# Must be a real, dedicated low-privilege test user (do not use the IS admin account here if you
# can avoid it - some scenarios exercise the account's own consent history, which is easier to
# reason about with a dedicated user).
TEST_USER_USERNAME=
TEST_USER_PASSWORD=

# Must be a real user assigned the dpdp-consent-admin role. The accelerator provisions the role
# itself automatically (DPDPIdentityExtensionTenantMgtListener / -ServiceComponent), but never role
# membership - run `bash scripts/provision-test-users.sh` to create this account and both required
# test users with their roles already assigned in one step. This one role grants every
# internal_consent_mgt_* scope (view/create/update/delete across consents, purposes and elements)
# as a single bundle, so this one persona both drives the admin consent registry UI and seeds
# Purposes/Elements/Consents via the API for tests/01-elements, tests/02-purposes, and
# tests/03-consents.
TEST_CONSENT_ADMIN_USERNAME=
TEST_CONSENT_ADMIN_PASSWORD=

# --- Optional: enables ownership-isolation tests --------------------------------------------
# A second, distinct user account. Tests that need to prove one user cannot
# see another's consent skip themselves when this isn't set.
TEST_USER_2_USERNAME=
TEST_USER_2_PASSWORD=

# --- Optional: enables real webhook delivery tests (tests/08-event-notifications) -----------
# WebhookReceiver (utils/webhookReceiver.ts) needs a real, non-loopback address the WSO2 IS
# process can reach - see tests/08-event-notifications/README.md, "Webhook-dependent tests"
# before setting this. This machine's own LAN IP (never localhost/127.0.0.1, which
# EventNotificationUrlValidator rejects unconditionally regardless of any config flag), for local
# dev/CI where the test runner and IS share a machine/LAN.
WEBHOOK_RECEIVER_HOST=
# Set true only once the running deployment.toml's
# [dpdp_accelerator.event_notifications.webhook] table has
# allow_private_network_callback_targets = true (it does NOT by default) - required whenever
# WEBHOOK_RECEIVER_HOST resolves to a site-local/RFC1918 address, which it normally will for a
# receiver running on the same LAN as the test runner.
WEBHOOK_RECEIVER_ALLOW_PRIVATE_NETWORK=false

# --- Optional: enables the real-scheduler consent-expiry test (tests/03-consents) -----------
# The real ConsentExpiryJob defaults to a daily cron ([dpdp_accelerator.consent_expiry].cron_value
# in deployment.toml = "0 0 0 * * ?"), far too slow to wait on in a test run. Set this only after
# editing that value to a short interval on the target server (e.g. "0/15 * * * * ?" for every
# 15s) and restarting it - then set this to a timeout comfortably larger than that interval (e.g.
# 60000 for a 15s cron). Leave unset to skip that one test; every other consent-expiry test in
# that file (which triggers reconciliation via a mutation instead of waiting on the cron) runs
# regardless of this server-side config.
CONSENT_EXPIRY_SCHEDULER_POLL_TIMEOUT_MS=
